{
  "name": "@boge-mvp/game-lib",
  "version": "2.0.7",
  "description": "TypeScript Library for LayaAir",
  "main": "index.js",
  "engines": {
    "node": ">=14.16.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "clean": "node packNpmLib.js removeTemp",
    "build:tscore": "node TSCore/build.js",
    "build:gamelib": "node GameLib/build.js",
    "build:demo": "node demo/build.js",
    "build": "npm run clean && npm run build:tscore && npm run build:gamelib && node packNpmLib.js packResources",
    "pack": "npm run build && npm pack",
    "test-install": "for /f %i in ('dir /b *.tgz') do npm install -g %i"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/boge-mvp/TypeScriptLib.git"
  },
  "keywords": [
    "webp",
    "laya",
    "typescript",
    "game-lib"
  ],
  "files": [
    "bin",
    "assets",
    "dist",
    "webp",
    "version_info.txt",
    "index.js",
    "lib",
    "typescript-parse.js",
    "reserved.js",
    "types.js",
    "rollup-plugin-rename.js",
    "rollup-plugin-decorators.js",
    "rollup-plugin-generics.js"
  ],
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "chalk": "^4.1.2",
    "core-js": "^3.50.0",
    "rollup": "^4.46.2",
    "rollup-plugin-glsl": "^1.3.0",
    "terser": "^5.43.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^14.18.63",
    "fs-extra": "^11.3.2"
  }
}
