{
  "type": "button",
  "name": "switchDemoBtn",
  "width": 260,
  "height": 38,
  "mode": "Check",
  "controllers": [
    {
      "name": "button",
      "pages": ["up", "down", "over", "selectedOver"],
      "selectedIndex": 0
    }
  ],
  "elements": [
    {
      "type": "graph",
      "name": "track",
      "x": 4,
      "y": 7,
      "width": 50,
      "height": 24,
      "fillColor": "#334155",
      "cornerRadius": 12,
      "gearColor": {
        "controller": "button",
        "pages": {
          "up": { "color": "#334155" },
          "down": { "color": "#10b981" },
          "over": { "color": "#475569" },
          "selectedOver": { "color": "#10b981" }
        }
      }
    },
    {
      "type": "graph",
      "name": "thumb",
      "x": 6,
      "y": 9,
      "width": 20,
      "height": 20,
      "fillColor": "#ffffff",
      "cornerRadius": 10,
      "gearXY": {
        "controller": "button",
        "tween": true,
        "duration": 0.2,
        "pages": {
          "up": { "x": 6, "y": 9 },
          "over": { "x": 6, "y": 9 },
          "down": { "x": 32, "y": 9 },
          "selectedOver": { "x": 32, "y": 9 }
        }
      }
    },
    {
      "type": "text",
      "name": "title",
      "x": 62,
      "y": 10,
      "width": 190,
      "text": "现代开关 (Switch 滑块切换)",
      "fontSize": 12,
      "bold": true,
      "color": "#ffffff"
    }
  ]
}
