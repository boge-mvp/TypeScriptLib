{
  "type": "button",
  "name": "treeItem",
  "width": 308,
  "height": 40,
  "mode": "Check",
  "controllers": [
    { "name": "button", "pages": ["up", "down", "over", "selectedOver"], "selectedIndex": 0 },
    { "name": "expanded", "pages": ["0", "1"], "selectedIndex": 0 },
    { "name": "leaf", "pages": ["0", "1"], "selectedIndex": 0 }
  ],
  "elements": [
    {
      "type": "graph",
      "name": "bg",
      "width": 308,
      "height": 40,
      "shape": "rect",
      "fillColor": "#0f2922",
      "lineSize": 1,
      "lineColor": "#134e4a",
      "cornerRadius": 6,
      "gearColor": {
        "controller": "button",
        "pages": {
          "up": { "color": "#0f2922", "strokeColor": "#134e4a" },
          "down": { "color": "#065f46", "strokeColor": "#34d399" },
          "over": { "color": "#113a31", "strokeColor": "#2dd4bf" },
          "selectedOver": { "color": "#047857", "strokeColor": "#6ee7b7" }
        }
      }
    },
    {
      "type": "group",
      "name": "indent",
      "x": 4,
      "y": 10,
      "width": 20,
      "height": 20
    },
    {
      "type": "button",
      "name": "expandButton",
      "x": 24,
      "y": 8,
      "width": 24,
      "height": 24,
      "mode": "Check",
      "gearDisplay": { "controller": "leaf", "pages": ["0"] },
      "elements": [
        { "type": "graph", "name": "hitArea", "width": 24, "height": 24, "shape": "rect", "fillColor": "#00000000" },
        {
          "type": "text",
          "name": "arrow",
          "width": 24,
          "height": 24,
          "text": "▸",
