{
  "type": "button",
  "name": "treeItem",
  "width": 360,
  "height": 36,
  "mode": "Check",
  "controllers": [
    { "name": "button", "pages": ["0", "1", "2", "3"], "selectedIndex": 0 }
  ],
  "elements": [
    {
      "type": "graph",
      "name": "bg",
      "width": 360,
      "height": 36,
      "shape": "rect",
      "fillColor": "#1e293b",
      "cornerRadius": 6,
      "gearColor": {
        "controller": "button",
        "pages": {
          "0": { "color": "#1e293b" },
          "1": { "color": "#0c4a6e" },
          "2": { "color": "#273549" },
          "3": { "color": "#075985" }
        }
      }
    },
    {
      "type": "graph",
      "name": "indent",
      "x": 8,
      "y": 8,
      "width": 0,
      "height": 20
    },
    {
      "type": "button",
      "name": "expandButton",
      "x": 8,
      "y": 6,
      "width": 24,
      "height": 24,
      "mode": "Check",
      "elements": [
        {
          "type": "text",
          "name": "arrowClosed",
          "width": 24,
          "height": 24,
          "text": "▸",
          "fontSize": 14,
          "color": "#94a3b8",
          "align": "center",
          "valign": "middle",
          "gearDisplay": { "controller": "button", "pages": ["0", "2"] }
        },
        {
          "type": "text",
          "name": "arrowOpen",
          "width": 24,
          "height": 24,
          "text": "▾",
          "fontSize": 14,
          "color": "#38bdf8",
          "align": "center",
          "valign": "middle",
          "gearDisplay": { "controller": "button", "pages": ["1", "3"] }
        }
      ]
    },
    {
      "type": "icon",
      "name": "icon",
      "x": 36,
      "y": 6,
      "width": 24,
      "height": 24,
      "fill": "scale"
    },
    {
      "type": "text",
      "name": "title",
      "x": 66,
      "y": 6,
      "width": 280,
      "height": 24,
      "fontSize": 13,
      "color": "#f1f5f9",
      "valign": "middle",
      "text": "节点"
    }
  ]
}
