    },
    {
      "type": "icon",
      "name": "icon",
      "x": 52,
      "y": 6,
      "width": 28,
      "height": 28,
      "fill": "scale",
      "url": "res/symbols/item_1.png"
    },
    {
      "type": "text",
      "name": "title",
      "x": 88,
      "y": 8,
      "width": 212,
